# Unlike .gitignore, these patterns do not recurse implicitly — **/ is load-
# bearing, or api/**/__pycache__ gets baked into the image and every host-side
# pytest run busts the COPY layer cache.
.git
.venv
.env
**/__pycache__
**/*.pyc
node_modules
docs
bench
# tests/ is deliberately NOT ignored: the Dockerfile's dev target copies it
# so the test image is self-contained. Only the dev stage's last layer
# depends on it; the runtime stages never COPY it.
