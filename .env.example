# Copy to .env and adjust. .env is gitignored; keep this file current.
#
# docker compose reads .env automatically, and docker-compose.yml carries
# these same values as ${VAR:-default} fallbacks, so a fresh clone works with
# no .env at all. Host-side tools (pytest, bench/ scripts, psql) do NOT read
# .env automatically — export it first:  set -a; source .env; set +a
# (pytest falls back to the defaults below via tests/conftest.py).

POSTGRES_USER=sieve
POSTGRES_PASSWORD=sieve
POSTGRES_DB=sieve

# Host port mappings; change these if 5432 or 8000 are already taken locally.
POSTGRES_PORT=5432
API_PORT=8000

# Used from the host. Inside compose, the api and migrate services get a URL
# pointing at the "postgres" service name instead.
DATABASE_URL=postgresql://sieve:sieve@localhost:5432/sieve
